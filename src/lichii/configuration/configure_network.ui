        </item>
        <item row="1" column="0" colspan="2">
         <widget class="QLabel" name="nextendo_description">
          <property name="text">
           <string>Nextendo Network is a community service that replaces Nintendo's online servers for Switch 1 games. When this is on, those games connect to Nextendo instead of Nintendo and send your Nextendo account token to it. Airplane mode is turned off.</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
